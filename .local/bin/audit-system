#!/bin/bash

SCRIPT_PATH="$(realpath -- "${BASH_SOURCE[0]}")"
NOTIFY_MESSAGES=()

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

DISABLE_NOTIFICATIONS=false
BACKGROUND=false

notify() {
    local title="System Check: Attention Required" message="$1"

    command -v notify-send >/dev/null 2>&1 && notify-send "$title" "$message"
}

format_section() {
    local section_title="$1" section_content="$2" title_color=$GREEN

    if [[ -n $section_content && $section_content != "-- No entries --" ]]; then
        title_color=$RED

        case $section_title in
            "Failed Services")
                NOTIFY_MESSAGES+=("Service failures: $(grep -c . <<< "$section_content") services")
                ;;
            "Pending Package Configs")
                NOTIFY_MESSAGES+=("Config updates needed: $(grep -c . <<< "$section_content") files")
                ;;
            "Log Errors")
                NOTIFY_MESSAGES+=("Log errors detected")
                ;;
            "Kernel Errors")
                NOTIFY_MESSAGES+=("Kernel errors detected")
                ;;
            "ClamAV Scan Results")
                NOTIFY_MESSAGES+=("Virus scan detected issues")
                ;;
        esac
    fi

    printf '%b%s:%b\n' "$title_color" "$section_title" "$NC"

    if [[ -n $section_content ]]; then
        sed 's/^/  /' <<< "$section_content"
    else
        echo "-- No entries --"
    fi

    echo
}

filter_dinit() {
    local line service scope

    {
        echo USER
        dinitctl list 2>/dev/null
        echo SYSTEM
        sudo dinitctl --system list 2>/dev/null
    } | while IFS= read -r line; do
        case $line in
            USER|SYSTEM)
                scope=$line
                ;;
            *"{X}"*)
                service=${line#*] }
                service=${service%% (exit status:*}
                printf '%s: %s\n' "${scope,,}" "$service"
                ;;
        esac
    done
}

filter_log_errors() {
    grep -RniE \
        '(^|[^[:alnum:]])(error|failed|failure|critical|fatal)([^[:alnum:]]|$)' \
        /var/log \
        --exclude=pacman.log \
        2>/dev/null |
        tail -n 50
}

filter_dmesg_errors() {
    dmesg --level=err,crit,alert,emerg 2>/dev/null |
        tail -n 50
}

while getopts ":b" opt; do
    case $opt in
        b)
            BACKGROUND=true
            DISABLE_NOTIFICATIONS=true
            ;;
        \?)
            echo "Invalid option: -$OPTARG" >&2
            ;;
    esac
done

# Create Output -----------------------------

clear
printf '%b\n\n' "${YELLOW}━━━ SYSTEM AUDIT ━━━${NC}"

failed_services=$(filter_dinit)
format_section "Failed Services" "$failed_services"

pacnew_files=$(find /etc -type f \( -name '*.pacnew' -o -name '*.pacsave' \) 2>/dev/null)
format_section "Pending Package Configs" "$pacnew_files"

log_errors=$(filter_log_errors)
format_section "Log Errors" "$log_errors"

dmesg_errors=$(filter_dmesg_errors)
format_section "Kernel Errors" "$dmesg_errors"

if command -v clamscan >/dev/null 2>&1; then
    clamav_results=""
    clamav_logs=(
        "/var/log/clamav/clamd.log"
        "/var/log/clamav/clamonacc.log"
    )

    for log in "${clamav_logs[@]}"; do
        infected_lines=$(grep -iE 'infected|FOUND' "$log" 2>/dev/null)

        if [[ -n $infected_lines ]]; then
            [[ -n $clamav_results ]] && clamav_results+=$'\n\n'
            clamav_results+="$infected_lines"
        fi
    done

    format_section "ClamAV Scan Results" "$clamav_results"
fi

if [[ $DISABLE_NOTIFICATIONS == false && ${#NOTIFY_MESSAGES[@]} -gt 0 ]]; then
    combined_message="System issues detected:"

    for msg in "${NOTIFY_MESSAGES[@]}"; do
        combined_message+=$'\n- '"$msg"
    done

    notify "$combined_message"
fi

if [[ $BACKGROUND == true && ${#NOTIFY_MESSAGES[@]} -gt 0 ]]; then
    DISABLE_FASTFETCH=1 alacritty -e bash -c "\"$SCRIPT_PATH\"; exec \"$SHELL\" -i" &
fi
